---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageKicker from '../components/PageKicker.astro';
import ServiceIcon from '../components/icons/ServiceIcon.astro';
import { photographs, site, wayfinding } from '../data/site';
import { withBase } from '../utils/withBase';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const title = 'Services';
const description =
  'Practical support for financial performance, restructuring, transactions and cross-border matters from GCAMS in Dubai.';
---

<Base title={title} description={description} path="/services">
  <section class="page-hero">
    <div class="wrap hero-split">
      <div class="prose">
        <PageKicker label={wayfinding['/services'].kicker} />
        <h1>Practical support for important decisions</h1>
        <p class="lede">
          From financial performance to restructuring and investment reviews, we help you assess the situation and move forward.
        </p>
      </div>
      <div class="photo-slot">
        <img
          src={withBase(photographs.services.src)}
          alt={photographs.services.alt}
          width={photographs.services.width}
          height={photographs.services.height}
          decoding="async"
          loading="lazy"
          fetchpriority="low"
        />
      </div>
    </div>
  </section>

  <section class="section section--tight section--band">
    <div class="wrap">
      {
        services.map((item) => (
          <details class="service-block" id={item.id}>
            <summary>
              <ServiceIcon id={item.id} />
              <span class="service-block__title">{item.data.title}</span>
              <span class="muted">{item.data.homeDescription}</span>
            </summary>
            <ul>
              {item.data.items.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
            {item.data.note ? <p class="small muted">{item.data.note}</p> : null}
          </details>
        ))
      }
      <p class="disclaimer">{site.servicesNote}</p>
    </div>
  </section>
</Base>

<script>
  function openHashedService() {
    const id = window.location.hash.slice(1);
    if (!id) return;
    const panel = document.getElementById(id);
    if (panel instanceof HTMLDetailsElement) panel.open = true;
  }

  openHashedService();
  window.addEventListener('hashchange', openHashedService);
</script>
