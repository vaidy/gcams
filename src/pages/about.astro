---
import Base from '../layouts/Base.astro';
import PageKicker from '../components/PageKicker.astro';
import { industries, photographs, site, wayfinding } from '../data/site';
import { withBase } from '../utils/withBase';

const title = 'About';
const description = site.positioning;
---

<Base title={title} description={description} path="/about">
  <section class="page-hero">
    <div class="wrap hero-split">
      <div class="prose">
        <PageKicker label={wayfinding['/about'].kicker} />
        <h1>Experienced advice. Practical execution.</h1>
        <p>
          GCAMS is a Dubai based corporate advisory and management consultancy. We support businesses, investors, lenders and professional advisers with financial decisions, restructuring and business improvement.
        </p>
      </div>
      <div class="photo-slot">
        <img
          src={withBase(photographs.about.src)}
          alt={photographs.about.alt}
          width={photographs.about.width}
          height={photographs.about.height}
          decoding="async"
          loading="lazy"
          fetchpriority="low"
        />
      </div>
    </div>
  </section>

  <section class="section section--band">
    <div class="wrap prose">
      <h2>Leadership and professional collaboration</h2>
      <h3>{site.managerPublic}</h3>
      <p class="muted">Founder and Principal Advisor | ACA | CMA</p>
      <p>
        Ram brings around 30 years of finance and business experience, including more than 25 years in the UAE. His work spans corporate finance, bank funding, acquisitions, restructuring, financial controls and ERP implementation. He is a DIFC registered Insolvency Practitioner, an IBBI registered Insolvency Professional and a member of INSOL International.
      </p>
      <p>
        For specialist assignments, GCAMS collaborates with appropriately qualified and licensed professionals according to the client’s needs. Roles and deliverables are agreed for each engagement.
      </p>
      <p>
        <a href={withBase('/credentials')}>View credentials</a>
        {site.linkedIn ? ' | ' : null}
        {
          site.linkedIn ? (
            <a href={site.linkedIn} rel="noopener noreferrer">
              LinkedIn
            </a>
          ) : null
        }
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="prose">
        <h2 id="industry-experience">Industry experience</h2>
        <p class="muted">
          Sector experience gained through senior finance and business leadership roles.
        </p>
      </div>
      <ul class="industry-labels">
        {industries.map((label) => <li>{label}</li>)}
      </ul>
    </div>
  </section>
</Base>
