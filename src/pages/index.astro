---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import NeedIcon from '../components/icons/NeedIcon.astro';
import ServiceIcon from '../components/icons/ServiceIcon.astro';
import { approach, clientNeeds, credentialsLine, industries, site, whatsappUaeUrl } from '../data/site';
import { withBase } from '../utils/withBase';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const title = 'Corporate advisory in Dubai';
const description = site.heroText;
---

<Base title={title} description={description} path="/">
  <section class="page-hero page-hero--home">
    <div class="wrap hero-split">
      <div>
        <h1>{site.heroHeading}</h1>
        <p class="lede">{site.heroText}</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={withBase('/contact')}>{site.primaryCta}</a>
          <a class="btn btn--ghost" href={withBase('/services')}>{site.secondaryCta}</a>
        </div>
      </div>
      <div class="photo-slot" aria-hidden="true"></div>
    </div>
  </section>

  <section class="cred-strip" aria-labelledby="cred-strip-label">
    <div class="wrap">
      <p id="cred-strip-label" class="cred-strip__label">Principal Advisor credentials</p>
      <ol class="cred-line">
        {
          credentialsLine.map((item) => (
            <li>
              {'href' in item && item.href ? (
                <a href={item.href} rel="noopener noreferrer">
                  {item.text}
                </a>
              ) : (
                item.text
              )}
            </li>
          ))
        }
      </ol>
      <a class="cred-strip__link" href={withBase('/credentials')}>View credentials</a>
    </div>
  </section>

  <section class="section section--band">
    <div class="wrap">
      <h2>What does your business need?</h2>
      <ul class="need-grid">
        {
          clientNeeds.map((item) => (
            <li>
              <a class="need-card" href={withBase(item.href)}>
                <NeedIcon id={item.id} />
                <h3>{item.title}</h3>
                <p class="muted">{item.text}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>Services</h2>
      <ul class="card-grid">
        {
          services.map((item) => (
            <li class="service-card">
              <ServiceIcon id={item.id} />
              <h3>{item.data.title}</h3>
              <p class="muted">{item.data.homeDescription}</p>
              <a class="service-card__more" href={`${withBase('/services')}#${item.id}`}>Learn more</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--band">
    <div class="wrap">
      <h2>Experience across industries</h2>
      <ul class="industry-labels">
        {industries.map((label) => <li>{label}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>How an engagement proceeds</h2>
      <ol class="approach-list approach-list--three">
        {
          approach.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p class="muted">{item.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--tight section--navy">
    <div class="wrap prose">
      <h2>{site.closeHeading}</h2>
      <p>{site.closeText}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={withBase('/contact')}>{site.closeCta}</a>
        <a class="btn btn--ghost" href={whatsappUaeUrl} rel="noopener noreferrer">WhatsApp</a>
      </div>
    </div>
  </section>
</Base>
