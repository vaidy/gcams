---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ServiceIcon from '../components/icons/ServiceIcon.astro';
import { approach, credentialsLine, site, whatsappUaeUrl } from '../data/site';
import { withBase } from '../utils/withBase';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const sectors = (await getCollection('sectors')).sort((a, b) => a.data.order - b.data.order);

const title = 'Corporate Advisory in the UAE and India';
const description =
  'UAE-based corporate advisory and management consultancy for finance transformation, restructuring, feasibility and cross-border support across the UAE and India.';
---

<Base title={title} description={description} path="/">
  <section class="page-hero page-hero--home">
    <div class="wrap">
      <h1>{site.heroHeading}</h1>
      <p class="lede">{site.heroText}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={withBase('/contact')}>{site.primaryCta}</a>
        <a class="btn btn--ghost" href={withBase('/services')}>{site.secondaryCta}</a>
        <a class="btn btn--ghost" href={whatsappUaeUrl} rel="noopener noreferrer">WhatsApp</a>
      </div>
      <ol class="cred-line">
        {
          credentialsLine.map((item) => (
            <li>
              {'href' in item && item.href ? (
                <a href={item.href} rel="noopener noreferrer">
                  {item.text}
                </a>
              ) : (
                item.text
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <hr class="rule wrap" />

  <section class="section">
    <div class="wrap prose">
      <h2>An independent advisory firm</h2>
      <p>
        Global Corporate Advisory and Management Services DWC-LLC combines senior finance leadership, operational understanding and restructuring experience to help clients evaluate opportunities, strengthen financial management, resolve business challenges and execute informed decisions. Our approach is independent, analytical and implementation-focused.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>How GCAMS works with clients</h2>
      <ul class="card-grid">
        {
          services.map((item) => (
            <li class="service-card">
              <ServiceIcon id={item.id} />
              <h3>{item.data.homeTitle}</h3>
              <p class="muted">{item.data.homeDescription}</p>
            </li>
          ))
        }
      </ul>
      <div class="btn-row">
        <a class="btn btn--ghost" href={withBase('/services')}>All services</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Where this experience is used</h2>
      <ul class="sector-chips">
        {
          sectors.map((item) => (
            <li>
              <a href={`${withBase('/sectors')}#${item.id}`}>{item.data.title}</a>
            </li>
          ))
        }
      </ul>
      <div class="btn-row">
        <a class="btn btn--ghost" href={withBase('/sectors')}>All sectors</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>How an engagement proceeds</h2>
      <ol class="approach-list">
        {
          approach.map((item, index) => (
            <li>
              <span class="idx" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{item.title}</h3>
                <p class="muted">{item.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap prose">
      <h2>Start a confidential conversation</h2>
      <p>Discuss a business challenge, transaction or transformation requirement with GCAMS. Initial conversations will be treated confidentially.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={withBase('/contact')}>{site.primaryCta}</a>
        <a class="btn btn--ghost" href={whatsappUaeUrl} rel="noopener noreferrer">WhatsApp</a>
      </div>
    </div>
  </section>
</Base>
