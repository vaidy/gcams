---
import Base from '../layouts/Base.astro';
import PageContinue from '../components/PageContinue.astro';
import PageKicker from '../components/PageKicker.astro';
import CredentialIcon from '../components/icons/CredentialIcon.astro';
import { site, wayfinding } from '../data/site';

const title = 'Credentials';
const description =
  'Professional registrations and memberships of Ramaswamy Chidambaram, Founder and Principal Advisor of GCAMS.';
---

<Base title={title} description={description} path="/credentials">
  <section class="page-hero">
    <div class="wrap prose">
      <PageKicker label={wayfinding['/credentials'].kicker} />
      <h1>Verified professional standing</h1>
      <p class="lede">
        Professional registrations and memberships of Ramaswamy Chidambaram, Founder and Principal Advisor.
      </p>
    </div>
  </section>

  <section class="section section--tight section--band">
    <div class="wrap">
      <div class="credential-grid">
        <article class="credential-card">
          <CredentialIcon id="difc" />
          <h2>DIFC Insolvency Practitioner</h2>
          <p>{site.difcWording}</p>
          <p>
            The DIFC registration is evidenced by his listing in the official Register of Insolvency Practitioners, with date of registration shown as {site.difcDate}.
          </p>
          <p>
            <a href={site.difcUrl} rel="noopener noreferrer">Official DIFC register</a>
          </p>
        </article>

        <article class="credential-card">
          <CredentialIcon id="ibbi" />
          <h2>IBBI Insolvency Professional</h2>
          <p>
            Registered with the Insolvency and Bankruptcy Board of India. Registration No. {site.ibbiRegistration}.
          </p>
        </article>

        <article class="credential-card">
          <CredentialIcon id="qualifications" />
          <h2>Qualifications and memberships</h2>
          <ul>
            <li>Chartered Accountant - ACA</li>
            <li>Cost and Management Accountant - CMA</li>
            <li>Member - INSOL International</li>
            <li>Member - Indian Institute of Insolvency Professionals of ICAI (IIIPI)</li>
          </ul>
        </article>

        <article class="credential-card">
          <CredentialIcon id="insol" />
          <h2>INSOL International</h2>
          <p>
            Member of INSOL International, a global association for restructuring and insolvency professionals.
          </p>
        </article>

        <article class="credential-card">
          <CredentialIcon id="firm" />
          <h2>Firm particulars</h2>
          <p>
            {site.legalName}. Registration No. {site.registrationNumber}. Licence No. {site.licenceNumber}. Incorporated {site.incorporationDate}.
          </p>
          <p>{site.addressUae}</p>
        </article>
      </div>
      <p class="muted small">
        GCAMS does not use “Official Liquidator” as a general title and does not imply a specific appointment unless separately appointed in a matter.
      </p>
    </div>
  </section>
  <PageContinue links={wayfinding['/credentials'].next} />
</Base>
