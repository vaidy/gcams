---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const title = 'Credentials';
const description =
  'Verified professional standing for GCAMS leadership, including DIFC Insolvency Practitioner and IBBI Insolvency Professional registrations.';
---

<Base title={title} description={description} path="/credentials">
  <section class="page-hero">
    <div class="wrap prose">
      <h1>Verified professional standing</h1>
      <p class="lede">
        Registrations and memberships that can be stated accurately for GCAMS leadership.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap prose">
      <article class="credential">
        <h2>DIFC Insolvency Practitioner</h2>
        <p>{site.difcWording}</p>
        <p>
          The DIFC registration is evidenced by his listing in the official Register of Insolvency Practitioners, with date of registration shown as {site.difcDate}.
        </p>
        <p>
          <a href={site.difcUrl} rel="noopener noreferrer">Official DIFC register</a>
        </p>
        <p class="muted small">
          GCAMS does not use “Official Liquidator” as a general title and does not imply a specific appointment unless separately appointed in a matter.
        </p>
      </article>

      <article class="credential">
        <h2>IBBI Insolvency Professional</h2>
        <p>
          Ramaswamy Chidambaram is an Insolvency Professional registered with the Insolvency and Bankruptcy Board of India.
        </p>
      </article>

      <article class="credential">
        <h2>Professional memberships</h2>
        <p>
          Chartered Accountant (ACA) and Cost Accountant (CMA).
        </p>
      </article>

      <article class="credential">
        <h2>Firm particulars</h2>
        <p>
          {site.legalName}. Registration No. {site.registrationNumber}. Licence No. {site.licenceNumber}. Incorporated {site.incorporationDate}.
        </p>
        <p>{site.addressUae}</p>
      </article>
    </div>
  </section>
</Base>
