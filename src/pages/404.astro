---
import Base from '../layouts/Base.astro';
import PageKicker from '../components/PageKicker.astro';
import { withBase } from '../utils/withBase';
---

<Base
  title="Page not found"
  description="The requested GCAMS page could not be found."
  path="/404"
>
  <section class="page-hero">
    <div class="wrap prose">
      <PageKicker label="Not found" />
      <h1>This page is not on the site</h1>
      <p>The address may be mistyped, or the page has not been published yet.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={withBase('/')}>Return home</a>
        <a class="btn btn--ghost" href={withBase('/contact')}>Contact GCAMS</a>
      </div>
    </div>
  </section>
</Base>
