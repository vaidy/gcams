---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found"
  description="The requested GCAMS page could not be found."
  path="/404"
>
  <section class="page-hero">
    <div class="wrap prose">
      <h1>This page is not on the site</h1>
      <p>The address may be mistyped, or the page has not been published yet.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/">Return home</a>
        <a class="btn btn--ghost" href="/contact">Contact GCAMS</a>
      </div>
    </div>
  </section>
</Base>
