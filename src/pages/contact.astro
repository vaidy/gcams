---
import Base from '../layouts/Base.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import PageKicker from '../components/PageKicker.astro';
import ContactIcon from '../components/icons/ContactIcon.astro';
import { site, wayfinding, whatsappUaeUrl } from '../data/site';

const title = 'Contact';
const description = 'Start a confidential conversation with GCAMS in Dubai.';
---

<Base title={title} description={description} path="/contact">
  <section class="page-hero">
    <div class="wrap">
      <div class="two-col">
        <div>
          <PageKicker label={wayfinding['/contact'].kicker} />
          <h1>{site.contactHeading}</h1>
          <p class="lede">{site.contactIntro}</p>
          <EnquiryForm />
        </div>
        <aside class="contact-aside">
          <div>
            <h2><ContactIcon id="address" /> Registered office</h2>
            <p>{site.addressUae}</p>
          </div>
          <div>
            <h2><ContactIcon id="phone" /> UAE telephone and WhatsApp</h2>
            <p>{site.phoneUae}</p>
            <div class="contact-actions">
              <a class="btn btn--primary" href={`tel:${site.phoneUaeTel}`}>Call UAE</a>
              <a class="btn btn--ghost" href={whatsappUaeUrl} rel="noopener noreferrer">
                WhatsApp UAE
              </a>
            </div>
          </div>
          {
            site.email ? (
              <div>
                <h2><ContactIcon id="email" /> Email</h2>
                <p>
                  <a href={`mailto:${site.email}`}>{site.email}</a>
                </p>
              </div>
            ) : null
          }
          {
            site.linkedIn ? (
              <div>
                <h2><ContactIcon id="linkedin" /> LinkedIn</h2>
                <p>
                  <a href={site.linkedIn} rel="noopener noreferrer">
                    Ramaswamy Chidambaram
                  </a>
                </p>
              </div>
            ) : null
          }
        </aside>
      </div>
    </div>
  </section>
</Base>
