---
interface Props {
  id: string;
}

const { id } = Astro.props;

const title =
  {
    '01-corporate-management': 'Corporate advisory',
    '02-finance-transformation': 'Finance transformation',
    '03-restructuring': 'Restructuring',
    '04-transactions': 'Transactions',
    '05-gcc-investor-outreach': 'Investor outreach',
    '06-feasibility': 'Feasibility',
    '07-cross-border': 'Cross-border support',
  }[id] ?? 'Advisory';
---

<svg class="service-card__icon" viewBox="0 0 24 24" aria-hidden="true">
  <title>{title}</title>
  {
    id === '01-corporate-management' ? (
      <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
        <rect x="3.5" y="8.5" width="17" height="12" />
        <path d="M8 8.5V4.5h8v4" />
        <path d="M8 13h2.5M13.5 13H16M8 16.5h2.5M13.5 16.5H16" />
      </g>
    ) : id === '02-finance-transformation' ? (
      <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 18.5V6M4 18.5h16" />
        <path d="M7.5 14.5l3.2-3.6 3 2.2 4.8-5.6" />
      </g>
    ) : id === '03-restructuring' ? (
      <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 8h9l-2.2-2.2M14 8l-2.2 2.2" />
        <path d="M19 16H10l2.2 2.2M10 16l2.2-2.2" />
      </g>
    ) : id === '04-transactions' ? (
      <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 8.5h10M7 15.5h10" />
        <path d="M15.2 6.3L17.8 8.5 15.2 10.7M8.8 13.3L6.2 15.5 8.8 17.7" />
      </g>
    ) : id === '05-gcc-investor-outreach' ? (
      <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
        <circle cx="12" cy="12" r="8" />
        <path d="M12 4v16M4 12h16" />
        <ellipse cx="12" cy="12" rx="3.6" ry="8" />
      </g>
    ) : id === '06-feasibility' ? (
      <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 4.5v4.2" />
        <path d="M6.2 19.2 12 8.7l5.8 10.5H6.2z" />
        <path d="M9.4 15.4h5.2" />
      </g>
    ) : (
      <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="7" cy="12" r="2.4" />
        <circle cx="17" cy="12" r="2.4" />
        <path d="M9.4 12h5.2" />
      </g>
    )
  }
</svg>
