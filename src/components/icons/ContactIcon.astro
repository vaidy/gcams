---
interface Props {
  id: 'address' | 'phone' | 'email' | 'linkedin';
}

const { id } = Astro.props;
---

<svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true">
  {
    id === 'address' ? (
      <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
        <path d="M12 20.5s6-5.1 6-9.2A6 6 0 0 0 6 11.3c0 4.1 6 9.2 6 9.2z" />
        <circle cx="12" cy="11" r="1.8" />
      </g>
    ) : id === 'phone' ? (
      <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8.2 4.8h2.1l1.1 2.6-1.4 1.1a11 11 0 0 0 4.5 4.5l1.1-1.4 2.6 1.1v2.1c0 .7-.6 1.3-1.3 1.3A12.2 12.2 0 0 1 6.9 6.1c0-.7.6-1.3 1.3-1.3z" />
      </g>
    ) : id === 'email' ? (
      <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
        <rect x="3.8" y="6" width="16.4" height="12" />
        <path d="M4.2 6.6 12 12.4l7.8-5.8" />
      </g>
    ) : (
      <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <rect x="4.5" y="4.5" width="15" height="15" rx="1.5" />
        <path d="M8 10.5V16M8 8.2h.01M12 16v-3.2a2 2 0 0 1 4 0V16" />
      </g>
    )
  }
</svg>
