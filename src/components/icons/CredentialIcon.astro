---
interface Props {
  id: 'difc' | 'ibbi' | 'qualifications' | 'insol' | 'firm';
}

const { id } = Astro.props;
---

<svg class="credential-card__icon" viewBox="0 0 24 24" aria-hidden="true">
  {
    id === 'difc' ? (
      <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
        <path d="M5 19.5h14" />
        <path d="M7 19.5V9.5h10v10" />
        <path d="M10 19.5v-4h4v4" />
        <path d="M9.5 12.5h.01M12 12.5h.01M14.5 12.5h.01" />
      </g>
    ) : id === 'ibbi' ? (
      <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="7.5" />
        <path d="M8.8 12.2l2.2 2.2 4.3-4.6" />
      </g>
    ) : id === 'qualifications' ? (
      <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
        <path d="M7 7.5h10M7 12h10M7 16.5h6" />
      </g>
    ) : id === 'insol' ? (
      <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
        <circle cx="12" cy="12" r="7.5" />
        <path d="M12 4.5v15M4.5 12h15" />
        <ellipse cx="12" cy="12" rx="3.2" ry="7.5" />
      </g>
    ) : (
      <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
        <rect x="4.5" y="8.5" width="15" height="11" />
        <path d="M8.5 8.5V5.5h7v3" />
        <path d="M10 13h4" />
      </g>
    )
  }
</svg>
