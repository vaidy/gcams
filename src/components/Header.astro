---
import { site } from '../data/site';
import { withBase } from '../utils/withBase';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string): boolean {
  const target = withBase(href).replace(/\/$/, '') || '/';
  return pathname === target;
}
---

<header class="site-header" data-site-header>
  <div class="wrap site-header__inner">
    <a
      class="brand"
      href={withBase('/')}
      aria-label="GCAMS home"
      aria-current={isActive('/') ? 'page' : undefined}
    >
      <img
        src={withBase('/images/gcams-logo.png')}
        srcset={`${withBase('/images/gcams-logo.png')} 786w, ${withBase('/images/gcams-logo@2x.png')} 1600w`}
        sizes="184px"
        width="786"
        height="181"
        fetchpriority="high"
        alt="GCAMS, Global Corporate Advisory and Management Services"
      />
    </a>
    <button
      class="nav-toggle"
      type="button"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="site-nav"
    >
      Menu
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Primary">
      {
        site.nav.map((item) => (
          <a
            class="site-nav__link"
            href={withBase(item.href)}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a class="btn btn--primary site-nav__cta" href={withBase('/contact')}>{site.headerCta}</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('[data-site-header]');
  const toggle = document.querySelector('[data-nav-toggle]');
  if (header instanceof HTMLElement && toggle instanceof HTMLButtonElement) {
    toggle.addEventListener('click', () => {
      const open = header.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.textContent = open ? 'Close' : 'Menu';
    });
  }
</script>
