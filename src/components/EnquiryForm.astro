---
import { formServices, site } from '../data/site';
import { withBase } from '../utils/withBase';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
const formReady = accessKey.length > 0;
---

<form
  class="form"
  data-enquiry-form
  data-enquiry-email={site.email}
  data-web3forms-key={formReady ? accessKey : undefined}
>
  <div class="field field--honeypot" aria-hidden="true">
    <label for="botcheck">Leave empty</label>
    <input id="botcheck" name="botcheck" type="checkbox" tabindex="-1" autocomplete="off" aria-hidden="true" />
  </div>
  <div class="field">
    <label for="name">Name</label>
    <input id="name" name="name" type="text" autocomplete="name" required />
  </div>
  <div class="field">
    <label for="organisation">Organisation</label>
    <input id="organisation" name="organisation" type="text" autocomplete="organization" required />
  </div>
  <div class="field">
    <label for="designation">Designation</label>
    <input id="designation" name="designation" type="text" autocomplete="organization-title" required />
  </div>
  <div class="field">
    <label for="email">Email</label>
    <input
      id="email"
      name="email"
      type="email"
      autocomplete="email"
      spellcheck="false"
      inputmode="email"
      placeholder="name@company.com…"
      required
    />
  </div>
  <div class="field">
    <label for="phone">Phone / WhatsApp</label>
    <input
      id="phone"
      name="phone"
      type="tel"
      autocomplete="tel"
      inputmode="tel"
      placeholder="+971 50 000 0000…"
      required
    />
  </div>
  <div class="field">
    <label for="country">Country</label>
    <input
      id="country"
      name="country"
      type="text"
      autocomplete="country-name"
      placeholder="United Arab Emirates…"
      required
    />
  </div>
  <div class="field">
    <label for="service">Service required</label>
    <select id="service" name="service" required>
      <option value="">Select a service…</option>
      {formServices.map((item) => <option value={item}>{item}</option>)}
    </select>
  </div>
  <div class="field">
    <label for="message">Brief message</label>
    <textarea
      id="message"
      name="message"
      placeholder="A short description of the decision or assignment…"
      required
    ></textarea>
  </div>
  <label class="consent">
    <input id="consent" name="consent" type="checkbox" required />
    <span>
      I have read the <a href={withBase('/privacy')}>Privacy Notice</a> and agree to GCAMS contacting me about this enquiry. Do not attach passports, bank statements, court papers or other confidential files.
    </span>
  </label>
  <button
    class:list={['btn', 'btn--primary', { 'btn--disabled': !formReady }]}
    type="submit"
    disabled={!formReady}
    data-enquiry-submit
  >
    Send an enquiry
  </button>
  <p class="form-note" data-form-status role="status" aria-live="polite">
    {
      formReady
        ? `Enquiries are sent to ${site.email}.`
        : 'The enquiry form is not available in this preview. Use the telephone, WhatsApp, or email on this page.'
    }
  </p>
</form>
<dialog class="enquiry-dialog" data-enquiry-success aria-labelledby="enquiry-success-copy">
  <p id="enquiry-success-copy">Thank you. GCAMS has received your enquiry and will reply.</p>
  <button class="btn btn--primary" type="button" data-enquiry-success-close>Close</button>
</dialog>

<script>
  const form = document.querySelector('[data-enquiry-form]');
  const status = document.querySelector('[data-form-status]');
  const submit = document.querySelector('[data-enquiry-submit]');
  const successDialog = document.querySelector('[data-enquiry-success]');
  const accessKey = form instanceof HTMLFormElement ? form.dataset.web3formsKey : undefined;
  const idleNote = status?.textContent ?? '';

  function setStatus(message: string) {
    if (status) status.textContent = message;
  }

  function showSuccessDialog() {
    if (!(successDialog instanceof HTMLDialogElement)) {
      console.error('[enquiry] success dialog missing');
      setStatus('Thank you. GCAMS has received your enquiry and will reply.');
      return;
    }
    console.info('[enquiry] opening success dialog');
    successDialog.showModal();
  }

  if (successDialog instanceof HTMLDialogElement) {
    const closeButton = successDialog.querySelector('[data-enquiry-success-close]');
    if (closeButton instanceof HTMLButtonElement) {
      closeButton.addEventListener('click', () => {
        console.info('[enquiry] closing success dialog');
        successDialog.close();
      });
    }
    successDialog.addEventListener('click', (event) => {
      if (event.target === successDialog) successDialog.close();
    });
  }

  if (form instanceof HTMLFormElement && submit instanceof HTMLButtonElement && accessKey) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const data = new FormData(form);
      const payload = {
        access_key: accessKey,
        subject: 'GCAMS website enquiry',
        from_name: String(data.get('name') ?? ''),
        name: String(data.get('name') ?? ''),
        email: String(data.get('email') ?? ''),
        organisation: String(data.get('organisation') ?? ''),
        designation: String(data.get('designation') ?? ''),
        phone: String(data.get('phone') ?? ''),
        country: String(data.get('country') ?? ''),
        service: String(data.get('service') ?? ''),
        message: String(data.get('message') ?? ''),
        consent: data.get('consent') ? 'yes' : 'no',
        botcheck: data.get('botcheck') ? 'true' : '',
      };

      submit.disabled = true;
      setStatus('Sending…');

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify(payload),
        });
        const result = (await response.json()) as { success?: boolean; message?: string };
        if (!response.ok || !result.success) {
          throw new Error(result.message || `The form could not be sent (${response.status}).`);
        }
        form.reset();
        setStatus(idleNote);
        showSuccessDialog();
      } catch (error) {
        const detail = error instanceof Error ? error.message : 'The form could not be sent.';
        console.error('[enquiry] send failed', error);
        setStatus(`${detail} You can also write to ${form.dataset.enquiryEmail ?? 'the email on this page'}, or use telephone or WhatsApp.`);
      } finally {
        submit.disabled = false;
      }
    });
  } else if (form instanceof HTMLFormElement) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      setStatus('The enquiry form is not available in this preview. Use the telephone, WhatsApp, or email on this page.');
    });
  }
</script>
