---
import { withBase } from '../utils/withBase';

interface Props {
  links: readonly { href: string; label: string }[];
}

const { links } = Astro.props;
const items = [{ href: '/', label: 'Home' }, ...links.filter((item) => item.href !== '/')];
---

<nav class="page-continue" aria-label="Also on this site">
  <div class="wrap">
    <p class="page-continue__label">Also on this site</p>
    <ul class="page-continue__list">
      {
        items.map((item) => (
          <li>
            <a href={withBase(item.href)}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>
