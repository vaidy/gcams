---
import SocialLinks from './SocialLinks.astro';
import { site, whatsappUaeUrl } from '../data/site';
import { withBase } from '../utils/withBase';
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="footer-brand">{site.brand}</p>
      <p class="footer-legal">{site.legalName}</p>
      <p class="footer-meta">
        Licence No. {site.licenceNumber} | Registration No. {site.registrationNumber} | Dubai South, Dubai, UAE
      </p>
      <p class="footer-meta">
        {site.email ? <a href={`mailto:${site.email}`}>{site.email}</a> : null}
        {site.email ? ' | ' : null}
        <a href={site.url}>{site.url.replace('https://', '')}</a>
        {' | '}
        <a href={`tel:${site.phoneUaeTel}`}>{site.phoneUae}</a>
      </p>
    </div>
    <nav class="footer-sitemap" aria-label="Site">
      <div>
        <p class="footer-heading">Pages</p>
        <ul class="footer-links">
          {
            site.nav.map((item) => (
              <li>
                <a href={withBase(item.href)}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="footer-heading">Legal</p>
        <ul class="footer-links">
          <li><a href={withBase('/privacy')}>Privacy</a></li>
          <li><a href={withBase('/terms')}>Terms</a></li>
        </ul>
        <p class="footer-heading">Talk</p>
        <ul class="footer-links">
          <li>
            <a href={whatsappUaeUrl} rel="noopener noreferrer">WhatsApp</a>
          </li>
          {
            site.linkedIn ? (
              <li>
                <a href={site.linkedIn} rel="noopener noreferrer">
                  LinkedIn
                </a>
              </li>
            ) : null
          }
        </ul>
      </div>
    </nav>
    <div class="footer-end">
      <div class="footer-social">
        <SocialLinks />
      </div>
    </div>
  </div>
  <p class="footer-copy wrap">© 2026 {site.legalName}. All rights reserved.</p>
</footer>
